From a3b6043532a47d3ec21c2c542d9e211ad0e28226 Mon Sep 17 00:00:00 2001
From: "qwen.ai[bot]" <qwenlm-intl@service.alibaba.com>
Date: Thu, 29 Oct 2026 18:03:40 +0000
Subject: [PATCH 1/3] Fix 'View' button in admin masters table: export
 IIFE-scoped functions to window

Root cause: cscOpenMasterView/cscShowViewError/cscRenderMasterView/cscEscapeHtml
were declared inside an IIFE, but the delegated click handler on .csc-view-master-btn
invoked them by name from global scope -> ReferenceError, modal never opened.
The 'if (!window.X) { function X() ... }' guards were broken (inner declarations
never assign to window; leftover braces also corrupted the script block).
Replaced with direct window.X = function assignments; internal calls still resolve
via closure hoisting. Also fixes same latent bug for cscEscapeHtml usage.
---
 includes/csc-masters.php | 19 +++++++++----------
 1 file changed, 9 insertions(+), 10 deletions(-)

diff --git a/includes/csc-masters.php b/includes/csc-masters.php
index 49f0a8f..a24b76b 100644
--- a/includes/csc-masters.php
+++ b/includes/csc-masters.php
@@ -1040,8 +1040,10 @@ if (!function_exists('csc_masters_admin_page')) {
                 cscModerateMasterFromModal(currentMasterId, 'block', reason);
             });
 
-            if (!window.cscOpenMasterView) {
-            function cscOpenMasterView(masterId) {
+            // Фикс: функции объявлены внутри IIFE и не видны из глобальной области.
+            // Экспортируем их в window, иначе делегированный обработчик клика по кнопке
+            // "Просмотр" получал ReferenceError: cscOpenMasterView is not defined.
+            window.cscOpenMasterView = function cscOpenMasterView(masterId) {
                 currentMasterId = masterId;
                 currentMasterData = null;
                 zoneMapInstance = null;
@@ -1083,15 +1085,13 @@ if (!function_exists('csc_masters_admin_page')) {
                     });
             }
 
-            if (!window.cscShowViewError) {
-            function cscShowViewError(message) {
+            window.cscShowViewError = function cscShowViewError(message) {
                 document.getElementById('csc-mv-loading').style.display = 'none';
                 document.getElementById('csc-mv-error').style.display = 'block';
                 document.getElementById('csc-mv-error-text').textContent = message;
-            }
+            };
 
-            if (!window.cscRenderMasterView) {
-            function cscRenderMasterView(data) {
+            window.cscRenderMasterView = function cscRenderMasterView(data) {
                 document.getElementById('csc-mv-loading').style.display = 'none';
                 document.getElementById('csc-mv-content').style.display = 'block';
 
@@ -1405,8 +1405,7 @@ if (!function_exists('csc_masters_admin_page')) {
                 return num.toLocaleString('ru-RU', { style: 'currency', currency: 'RUB', maximumFractionDigits: 0 });
             }
 
-            if (!window.cscEscapeHtml) {
-            function cscEscapeHtml(str) {
+            window.cscEscapeHtml = function cscEscapeHtml(str) {
                 if (str === null || str === undefined) return '';
                 return String(str)
                     .replace(/&/g, '&amp;')
@@ -1414,7 +1413,7 @@ if (!function_exists('csc_masters_admin_page')) {
                     .replace(/>/g, '&gt;')
                     .replace(/"/g, '&quot;')
                     .replace(/'/g, '&#039;');
-            }
+            };
         })();
         </script>
         <?php
-- 
